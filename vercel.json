{
  "crons": [
    {
      "path": "/api/cron/auto-classify",
      "schedule": "0 20 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/promo",
      "destination": "/index.html"
    }
  ],
  "outputDirectory": "www",
  "ignoreCommand": "[ \"$VERCEL_GIT_COMMIT_MESSAGE\" = \"ci: restore read-only YouTube audit (configuration only)\" ]"
}
