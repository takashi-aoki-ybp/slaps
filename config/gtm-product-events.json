          {
            "type": "TEMPLATE",
            "key": "javascript",
            "value": "function() {\n  var currentEvent = {{Event}};\n  var currentId = {{SLAPS - GTM event ID}};\n  if (currentId == null) return {};\n  var allowed = [\"youtube_id\",\"mode\",\"tracks_loaded\",\"region\",\"era\",\"order\",\"suggestions\",\"action\",\"count\",\"date\",\"start_index\",\"days_since_first_visit\",\"measurement_version\",\"share_outcome\",\"cohort_date\"];\n  var layer = window.dataLayer || [];\n  for (var i = layer.length - 1; i >= 0; i--) {\n    var entry = layer[i];\n    if (entry && entry.event === currentEvent && entry[\"gtm.uniqueEventId\"] === currentId) {\n      var result = {};\n      for (var j = 0; j < allowed.length; j++) {\n        var key = allowed[j];\n        var value = entry[key];\n        if (typeof value === 'string' || typeof value === 'number' || typeof value === 'boolean') {\n          result[key] = value;\n        }\n      }\n      if ({{Debug Mode}}) result.debug_mode = true;\n      return result;\n    }\n  }\n  return {};\n}"
          }
        ]
